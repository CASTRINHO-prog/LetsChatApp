rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isParticipant(conversationId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(conversationId);
        allow create: if isParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000;
        allow update, delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.auth.uid in request.resource.data.adminIds
        && request.resource.data.adminIds.size() <= 5
        && request.resource.data.adminIds.size() >= 1
        && request.resource.data.adminIds.hasOnly(request.resource.data.memberIds);
      allow update: if signedIn()
        && request.auth.uid in resource.data.adminIds
        && request.resource.data.adminIds.size() <= 5
        && request.resource.data.adminIds.size() >= 1
        && request.resource.data.adminIds.hasOnly(request.resource.data.memberIds)
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if signedIn() && request.auth.uid in resource.data.adminIds;
    }


    // LetsPay: os dados financeiros só podem ser consultados pelo próprio titular.
    // Escritas de saldos e transacções são exclusivamente do backend confiável
    // (Firebase Admin SDK / Cloud Functions), nunca directamente do telemóvel.
    match /wallets/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;

      match /transactions/{transactionId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }
  }
}
